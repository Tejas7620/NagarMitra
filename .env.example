# ============================================================
# NagarMitra AI — Environment Configuration Example
# Copy this file to .env.local to configure custom providers.
# All services operate with built-in fallbacks if keys are not set.
# ============================================================

# ------------------------------------------------------------
# 1. Database (Optional Supabase Cloud Integration)
# If omitted, NagarMitra AI automatically uses local file-backed
# disk persistence (data/db/) with zero data loss on restart.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------
# 2. Server-side AI Provider (Gemini / LLM Incident Extraction)
# If omitted or offline, deterministic NLP extraction fallback is used.
# ------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# 3. Routing Provider
# Uses public OSRM server by default (walking, driving, cycling).
# ------------------------------------------------------------
ROUTING_PROVIDER=osrm
ROUTING_API_BASE_URL=https://router.project-osrm.org

# ------------------------------------------------------------
# 4. Geocoding Provider
# Uses OpenStreetMap Nominatim by default (all India & global coverage).
# ------------------------------------------------------------
GEOCODING_PROVIDER=nominatim
GEOCODING_API_BASE_URL=https://nominatim.openstreetmap.org

# ------------------------------------------------------------
# 5. Places Discovery Provider
# Uses Overpass API / Curated OpenStreetMap datasets by default.
# ------------------------------------------------------------
PLACES_PROVIDER=curated_osm
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ------------------------------------------------------------
# 6. Weather Provider
# Uses Open-Meteo free global weather service by default.
# ------------------------------------------------------------
WEATHER_PROVIDER=open_meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
